# Copy this file to `.env` and fill it in. `.env` is git-ignored, but it is
# meant to hold ids and *pointers* to secrets, not the secrets themselves.

# --- Instagram API (with Instagram Login) ---------------------------------
# The *Instagram* app ID from the use case page on developers.facebook.com
# (Use cases -> Manage messaging & content on Instagram -> API setup with
# Instagram login). NOT the Facebook app ID.
IG_APP_ID=

# Where the Instagram app secret lives. Preferred: a gopass entry whose first
# line is the secret. Alternative for one-off runs: IG_APP_SECRET=... directly.
# Only `negahban auth` reads it.
# NEGAHBAN_GOPASS_APP_SECRET=token/meta/your-instagram-app
# IG_APP_SECRET=

# Where the access token lives and gets refreshed. Preferred: a gopass entry
# whose first line is the token (negahban adds an `expires_at:` line to it).
# Paste the token from the dashboard's "Generate access tokens" button there,
# then run `negahban auth` once. Leave unset to use token.json next to the
# code instead, seeded with `negahban auth --token ...`.
# NEGAHBAN_GOPASS_TOKEN=token/instagram/your.username

# --- Claude ---------------------------------------------------------------
# Preferred: a gopass entry whose first line is the Anthropic API key.
# Otherwise the SDK resolves ANTHROPIC_API_KEY / ANTHROPIC_AUTH_TOKEN itself.
# NEGAHBAN_GOPASS_ANTHROPIC_KEY=token/anthropic/negahban
# ANTHROPIC_API_KEY=

# Model used for comment classification.
# NEGAHBAN_MODEL=claude-opus-5

# --- Policy ---------------------------------------------------------------
# Usernames (comma separated) that are never acted on, whatever they write.
# NEGAHBAN_ALLOWLIST=best_friend,my_sister
