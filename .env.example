# Copy this file to `.env` and fill it in. `.env` is git-ignored.

# --- Instagram API (with Instagram Login) ---------------------------------
# The *Instagram* app ID/secret from the use case page on developers.facebook.com
# (Use cases -> Manage messaging & content on Instagram -> API setup with
# Instagram login). NOT the Facebook app ID.
IG_APP_ID=
IG_APP_SECRET=

# Optional: a long-lived user token to start from. The simplest way to get one
# is the "Generate access tokens" button on the same page, after adding your
# professional account as an Instagram Tester. `negahban auth` stores it in
# token.json and refreshes it before it expires, so this is only needed once.
# IG_ACCESS_TOKEN=

# --- Claude ---------------------------------------------------------------
# Resolved by the Anthropic SDK; an `ant auth login` profile also works.
# ANTHROPIC_API_KEY=

# Model used for comment classification.
# NEGAHBAN_MODEL=claude-opus-5

# --- Policy ---------------------------------------------------------------
# Usernames (comma separated) that are never acted on, whatever they write.
# NEGAHBAN_ALLOWLIST=best_friend,my_sister
